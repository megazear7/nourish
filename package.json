{
  "name": "nourish",
  "version": "1.0.0",
  "description": "A simple, elegant nutrition tracker PWA built on the Zelt stack",
  "type": "module",
  "scripts": {
    "start": "run-p build serve",
    "serve": "npx serve dist/client -l 3000",
    "watch": "run-p watch:tsc watch:rollup",
    "watch:rollup": "rollup -c --watch",
    "watch:tsc": "tsc --watch",
    "build": "run-s build:tsc build:rollup build:static",
    "build:static": "mkdir -p dist/client && cp index.html manifest.json favicon.svg public/sw.js dist/client/",
    "build:rollup": "rollup -c",
    "build:tsc": "tsc",
    "lint": "prettier src --check && eslint src",
    "fix": "prettier src --write && eslint src --fix"
  },
  "keywords": ["Zod", "Lit", "TypeScript", "PWA", "Nutrition"],
  "author": "Alex Lockhart",
  "license": "ISC",
  "dependencies": {
    "@lit/context": "^1.1.6",
    "lit": "^3.3.1",
    "zod": "^4.1.12"
  },
  "devDependencies": {
    "@eslint/js": "^9.39.0",
    "@rollup/plugin-node-resolve": "^16.0.3",
    "@rollup/plugin-replace": "^6.0.3",
    "@rollup/plugin-typescript": "^12.3.0",
    "@types/node": "^24.9.2",
    "eslint": "^9.39.0",
    "npm-run-all": "^4.1.5",
    "prettier": "^3.6.2",
    "rollup": "^4.52.5",
    "tslib": "^2.8.1",
    "typescript": "^5.9.3",
    "typescript-eslint": "^8.46.2"
  }
}
