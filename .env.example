# Copy to .env for local Auth0. Never commit .env.
# Browser values are baked in at build time. Server values are read when the API starts.

# Auth0 SPA domain, without https://. Example: login.megazear7.com
AUTH0_DOMAIN=
# SPA client id. Not a secret. Still do not commit a real .env.
AUTH0_CLIENT_ID=
# Access-token audience. Defaults to the Megazear identity API.
AUTH0_AUDIENCE=https://identity.megazear7.com
# Optional extra issuer hosts, comma-separated, if tokens use a custom domain.
AUTH0_ISSUER_DOMAINS=
# Identity document endpoint. Defaults to production.
NOURISH_IDENTITY_URL=https://identity.megazear7.com/data

# Real Auth0 database user for `npm run test:auth`. Never put these in the browser bundle.
TEST_USERNAME=
TEST_PASSWORD=
# Optional. Defaults to http://127.0.0.1:3000. Point at a deploy preview to test that build.
# NOURISH_BASE_URL=

# Netlify sets one of these when Netlify Database is enabled.
# NETLIFY_DB_URL=
